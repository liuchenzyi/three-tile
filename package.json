{
	"name": "three-tile",
	"version": "0.11.10",
	"description": "A lightweight tile map using threejs",
	"keywords": [
		"3D",
		"cesium",
		"gis",
		"map",
		"three",
		"tile"
	],
	"homepage": "https://github.com/sxguojf/three-tile#readme",
	"bugs": {
		"url": "https://github.com/sxguojf/three-tile/issues"
	},
	"license": "MIT",
	"author": {
		"name": "GuoJF",
		"email": "hz_gjf@163.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sxguojf/three-tile.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.umd.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.umd.cjs"
		},
		"./plugin": {
			"types": "./dist/plugin/index.d.ts",
			"import": "./dist/plugin/index.js",
			"require": "./dist/plugin/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"dev": "pnpm --filter three-tile-demo dev",
		"build": "pnpm build:lib && pnpm build:plugin",
		"build:lib": "pnpm --filter @three-tile/lib build",
		"build:demo": "pnpm --filter three-tile-demo build",
		"build:plugin": "pnpm --filter @three-tile/plugin build",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"format": "oxfmt",
		"lint": "oxlint . -D correctness",
		"lint:fix": "oxlint . --fix -D correctness",
		"prepare": "husky",
		"docs": "pnpm --filter @three-tile/lib docs && pnpm --filter @three-tile/plugin docs"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.0",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^26.1.0",
		"@types/three": "^0.185.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"typedoc": "^0.28.19",
		"typescript": "^6.0.3",
		"vite": "8.1.3",
		"vite-plugin-dts": "^5.0.3"
	},
	"peerDependencies": {
		"three": "^0.185.0"
	}
}
